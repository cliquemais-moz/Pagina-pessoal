import React, { useEffect, useState } from "react";

const topics = [
  { name: "Tecnologia", icon: "💻" },
  { name: "Esportes", icon: "⚽" },
  { name: "Negócios", icon: "💼" },
  { name: "Arte", icon: "🎨" },
  { name: "Ciência", icon: "🔬" },
  { name: "Música", icon: "🎵" },
  { name: "Educação", icon: "📚" },
  { name: "Viagens", icon: "✈️" },
];

const steps = [
  "Identificação",
  "Conhecimento",
  "Interesse",
  "Confirmação",
  "Resultado",
];

export default function App() {
  const [step, setStep] = useState(1);

  const [form, setForm] = useState({
    name: "",
    email: "",
    category: "Geral",
    topic: "",
    username: "",
  });

  const [attempt, setAttempt] = useState(0);
  const [answerStatus, setAnswerStatus] = useState(null);
  const [selectedNumber, setSelectedNumber] = useState(null);

  const [processing, setProcessing] = useState(false);
  const [processIndex, setProcessIndex] = useState(0);

  const [showVideo, setShowVideo] = useState(false);

  // =========================
  // FORMULÁRIO
  // =========================

  const updateForm = (field, value) => {
    setForm((prev) => ({
      ...prev,
      [field]: value,
    }));
  };

  const startQuiz = (e) => {
    e.preventDefault();

    if (!form.name.trim() || !form.email.trim()) {
      alert("Preencha seu nome e e-mail para continuar.");
      return;
    }

    setStep(2);
  };

  // =========================
  // ETAPA 2
  // =========================

  const handleAnswer = (number) => {
    setSelectedNumber(number);

    // Primeira tentativa
    if (attempt === 0) {
      setAttempt(1);
      setAnswerStatus("wrong");
      return;
    }

    // Segunda tentativa
    setAnswerStatus("correct");

    setTimeout(() => {
      setStep(3);
      setAnswerStatus(null);
      setSelectedNumber(null);
      setAttempt(0);
    }, 1200);
  };

  const retryAnswer = () => {
    setAnswerStatus(null);
    setSelectedNumber(null);
  };

  // =========================
  // ETAPA 3
  // =========================

  const selectTopic = (topic) => {
    updateForm("topic", topic);

    setTimeout(() => {
      setStep(4);
    }, 350);
  };

  // =========================
  // ETAPA 4
  // =========================

  const continueProfile = (e) => {
    e.preventDefault();

    if (!form.username.trim()) {
      alert("Digite seu código ou username.");
      return;
    }

    setProcessing(true);
    setStep("processing");
  };

  // =========================
  // PROCESSAMENTO
  // =========================

  useEffect(() => {
    if (step !== "processing") return;

    setProcessIndex(0);

    const timers = [
      setTimeout(() => setProcessIndex(1), 900),
      setTimeout(() => setProcessIndex(2), 1800),
      setTimeout(() => setProcessIndex(3), 2700),
      setTimeout(() => {
        setProcessing(false);
        setStep(5);
      }, 3500),
    ];

    return () => timers.forEach(clearTimeout);
  }, [step]);

  // =========================
  // TELA DO VÍDEO
  // =========================

  if (showVideo) {
    return <VideoPage name={form.name} />;
  }

  return (
    <div className="min-h-screen bg-gray-100 px-4 py-6 sm:py-10">
      <div className="mx-auto w-full max-w-xl overflow-hidden rounded-2xl bg-white shadow-xl">

        {/* HEADER */}
        <header className="border-b border-gray-100 bg-white px-5 py-5 sm:px-7">
          <div className="flex items-center justify-between">

            <div className="flex items-center gap-2">
              <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-xl text-white shadow-sm">
                ★
              </div>

              <div>
                <h1 className="text-lg font-bold text-gray-900">
                  QuizApp
                </h1>
                <p className="text-xs text-gray-500">
                  Perfil Interativo
                </p>
              </div>
            </div>

            {step !== 1 && step !== "processing" && (
              <div className="rounded-full bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-600">
                Etapa {step} de 5
              </div>
            )}
          </div>
        </header>

        {/* PROGRESSO */}
        {step !== "processing" && (
          <div className="px-5 pt-5 sm:px-7">
            <div className="mb-2 flex justify-between text-[10px] font-medium uppercase tracking-wide text-gray-400">
              <span>Progresso</span>
              <span>
                {step === 1
                  ? "20%"
                  : step === 2
                  ? "40%"
                  : step === 3
                  ? "60%"
                  : step === 4
                  ? "80%"
                  : "100%"}
              </span>
            </div>

            <div className="h-2 overflow-hidden rounded-full bg-gray-100">
              <div
                className="h-full rounded-full bg-green-500 transition-all duration-500"
                style={{
                  width:
                    step === 1
                      ? "20%"
                      : step === 2
                      ? "40%"
                      : step === 3
                      ? "60%"
                      : step === 4
                      ? "80%"
                      : "100%",
                }}
              />
            </div>

            <div className="mt-3 grid grid-cols-5 gap-1">
              {steps.map((item, index) => {
                const active = index + 1 <= step;

                return (
                  <div
                    key={item}
                    className={`text-center text-[9px] ${
                      active
                        ? "font-semibold text-green-600"
                        : "text-gray-400"
                    }`}
                  >
                    {item}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* CONTEÚDO */}
        <main className="px-5 py-7 sm:px-7 sm:py-9">

          {/* ================= ETAPA 1 ================= */}

          {step === 1 && (
            <section>
              <div className="mb-7 text-center">
                <div className="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-indigo-50 text-3xl">
                  👋
                </div>

                <h2 className="text-2xl font-bold text-gray-900">
                  Bem-vindo ao Nosso Quiz!
                </h2>

                <p className="mt-2 text-sm leading-6 text-gray-500">
                  Preencha seus dados para começar a responder.
                </p>
              </div>

              <form onSubmit={startQuiz} className="space-y-5">

                <div>
                  <label className="mb-2 block text-sm font-semibold text-gray-700">
                    Nome Completo
                  </label>

                  <input
                    type="text"
                    value={form.name}
                    onChange={(e) =>
                      updateForm("name", e.target.value)
                    }
                    placeholder="Digite seu nome"
                    className="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3.5 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
                  />
                </div>

                <div>
                  <label className="mb-2 block text-sm font-semibold text-gray-700">
                    E-mail
                  </label>

                  <input
                    type="email"
                    value={form.email}
                    onChange={(e) =>
                      updateForm("email", e.target.value)
                    }
                    placeholder="seuemail@exemplo.com"
                    className="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3.5 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
                  />
                </div>

                <div>
                  <label className="mb-3 block text-sm font-semibold text-gray-700">
                    Qual categoria representa melhor seu interesse?
                  </label>

                  <div className="space-y-3">
                    {[
                      "Geral",
                      "Avançada",
                      "Especialista",
                    ].map((category) => (
                      <label
                        key={category}
                        className={`flex cursor-pointer items-center rounded-xl border p-4 transition ${
                          form.category === category
                            ? "border-indigo-500 bg-indigo-50"
                            : "border-gray-200 bg-white hover:border-gray-300"
                        }`}
                      >
                        <input
                          type="radio"
                          name="category"
                          value={category}
                          checked={form.category === category}
                          onChange={(e) =>
                            updateForm("category", e.target.value)
                          }
                          className="h-4 w-4 accent-indigo-600"
                        />

                        <span className="ml-3 text-sm font-medium text-gray-700">
                          Categoria {category}
                        </span>
                      </label>
                    ))}
                  </div>
                </div>

                <button
                  type="submit"
                  className="w-full rounded-xl bg-indigo-600 py-4 text-sm font-bold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700 active:scale-[0.98]"
                >
                  INICIAR QUIZ
                </button>
              </form>
            </section>
          )}

          {/* ================= ETAPA 2 ================= */}

          {step === 2 && (
            <section>
              <div className="mb-6">
                <span className="text-xs font-bold uppercase tracking-wider text-indigo-600">
                  ETAPA 2 DE 5 · Pergunta de Conhecimento
                </span>

                <h2 className="mt-3 text-2xl font-bold text-gray-900">
                  Olá, {form.name}!
                </h2>

                <p className="mt-2 text-sm leading-6 text-gray-500">
                  Escolha o número correspondente à opção correta
                  para avançar.
                </p>
              </div>

              {answerStatus === "wrong" && (
                <div className="mb-5 rounded-xl border border-red-100 bg-red-50 p-4">
                  <p className="text-sm font-semibold text-red-600">
                    Resposta incorreta.
                  </p>

                  <p className="mt-1 text-xs text-red-500">
                    Você tem mais 1 tentativa!
                  </p>

                  <button
                    onClick={retryAnswer}
                    className="mt-3 rounded-lg bg-red-500 px-4 py-2 text-xs font-bold text-white hover:bg-red-600"
                  >
                    TENTAR NOVAMENTE
                  </button>
                </div>
              )}

              {answerStatus === "correct" && (
                <div className="mb-5 rounded-xl border border-green-200 bg-green-50 p-4">
                  <p className="text-sm font-bold text-green-600">
                    ✓ Resposta correta!
                  </p>

                  <p className="mt-1 text-xs text-green-600">
                    Avançando...
                  </p>
                </div>
              )}

              <div className="grid grid-cols-2 gap-3 sm:grid-cols-5">
                {Array.from({ length: 10 }, (_, index) => {
                  const number = index + 1;

                  return (
                    <button
                      key={number}
                      disabled={answerStatus === "correct"}
                      onClick={() => handleAnswer(number)}
                      className={`flex aspect-square items-center justify-center rounded-xl border text-lg font-bold transition ${
                        selectedNumber === number
                          ? answerStatus === "wrong"
                            ? "border-red-400 bg-red-50 text-red-600"
                            : answerStatus === "correct"
                            ? "border-green-400 bg-green-50 text-green-600"
                            : "border-indigo-500 bg-indigo-50 text-indigo-600"
                          : "border-gray-200 bg-white text-gray-700 hover:border-indigo-400 hover:bg-indigo-50 hover:text-indigo-600"
                      }`}
                    >
                      {number}
                    </button>
                  );
                })}
              </div>

              <div className="mt-7 rounded-xl bg-gray-50 p-4 text-center">
                <p className="text-xs text-gray-500">
                  Tentativa atual:{" "}
                  <strong className="text-gray-700">
                    {attempt + 1} de 2
                  </strong>
                </p>
              </div>
            </section>
          )}

          {/* ================= ETAPA 3 ================= */}

          {step === 3 && (
            <section>
              <div className="mb-6">
                <span className="text-xs font-bold uppercase tracking-wider text-indigo-600">
                  ETAPA 3 DE 5
                </span>

                <h2 className="mt-3 text-2xl font-bold text-gray-900">
                  Selecione seu Tópico de Interesse
                </h2>

                <p className="mt-2 text-sm leading-6 text-gray-500">
                  Escolha uma opção para continuar.
                </p>
              </div>

              <div className="grid grid-cols-2 gap-3">
                {topics.map((topic) => (
                  <button
                    key={topic.name}
                    onClick={() => selectTopic(topic.name)}
                    className={`rounded-2xl border p-5 text-left transition hover:-translate-y-0.5 hover:border-indigo-400 hover:bg-indigo-50 ${
                      form.topic === topic.name
                        ? "border-indigo-500 bg-indigo-50"
                        : "border-gray-200 bg-white"
                    }`}
                  >
                    <div className="mb-3 text-3xl">
                      {topic.icon}
                    </div>

                    <p className="text-sm font-bold text-gray-800">
                      {topic.name}
                    </p>

                    <p className="mt-1 text-xs text-gray-400">
                      Selecionar
                    </p>
                  </button>
                ))}
              </div>
            </section>
          )}

          {/* ================= ETAPA 4 ================= */}

          {step === 4 && (
            <section>
              <div className="mb-7 text-center">
                <div className="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-indigo-50 text-3xl">
                  🔐
                </div>

                <span className="text-xs font-bold uppercase tracking-wider text-indigo-600">
                  ETAPA 4 DE 5 · Confirmação de Usuário
                </span>

                <h2 className="mt-3 text-2xl font-bold text-gray-900">
                  Confirme seu perfil
                </h2>

                <p className="mt-2 text-sm leading-6 text-gray-500">
                  Insira seu código de usuário ou nome de usuário
                  da plataforma.
                </p>
              </div>

              <form onSubmit={continueProfile} className="space-y-5">

                <div>
                  <label className="mb-2 block text-sm font-semibold text-gray-700">
                    Código / Username
                  </label>

                  <input
                    type="text"
                    value={form.username}
                    onChange={(e) =>
                      updateForm("username", e.target.value)
                    }
                    placeholder="ex: user_12345"
                    className="w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-4 text-sm outline-none transition focus:border-indigo-500 focus:bg-white focus:ring-4 focus:ring-indigo-100"
                  />
                </div>

                <div className="rounded-xl bg-indigo-50 p-4">
                  <p className="text-xs leading-5 text-indigo-700">
                    Seus dados serão utilizados apenas para
                    preparar seu resultado personalizado.
                  </p>
                </div>

                <button
                  type="submit"
                  className="w-full rounded-xl bg-indigo-600 py-4 text-sm font-bold text-white shadow-lg shadow-indigo-200 transition hover:bg-indigo-700 active:scale-[0.98]"
                >
                  CONTINUAR
                </button>
              </form>
            </section>
          )}

          {/* ================= PROCESSAMENTO ================= */}

          {step === "processing" && (
            <ProcessingScreen processIndex={processIndex} />
          )}

          {/* ================= ETAPA 5 ================= */}

          {step === 5 && (
            <section>
              <div className="mb-6 overflow-hidden rounded-2xl border border-green-200">
                <div className="bg-green-500 px-5 py-4 text-center text-sm font-bold text-white">
                  ✓ PERFIL GERADO COM SUCESSO!
                </div>

                <div className="bg-green-50 p-5 text-center">
                  <div className="mx-auto mb-3 flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-2xl">
                    🎉
                  </div>

                  <h2 className="text-xl font-bold text-gray-900">
                    Parabéns, {form.name}!
                  </h2>

                  <p className="mt-2 text-sm text-gray-600">
                    Suas respostas foram salvas.
                  </p>
                </div>
              </div>

              <div className="text-center">
                <h3 className="text-lg font-bold text-gray-900">
                  Seu resultado está pronto
                </h3>

                <p className="mx-auto mt-2 max-w-md text-sm leading-6 text-gray-500">
                  Assista ao vídeo abaixo para ver a explicação
                  detalhada do seu resultado.
                </p>

                <button
                  onClick={() => setShowVideo(true)}
                  className="mt-7 w-full rounded-xl bg-green-500 py-4 text-sm font-bold text-white shadow-lg shadow-green-100 transition hover:bg-green-600 active:scale-[0.98]"
                >
                  ► ASSISTIR VÍDEO DO RESULTADO
                </button>
              </div>

              <div className="mt-6 flex flex-wrap justify-center gap-2">
                <span className="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-500">
                  Categoria: {form.category}
                </span>

                <span className="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-500">
                  Tópico: {form.topic}
                </span>
              </div>
            </section>
          )}
        </main>

        {/* FOOTER */}
        <footer className="border-t border-gray-100 px-5 py-5 text-center">
          <p className="text-xs text-gray-400">
            © 2026 QuizApp. Todos os direitos reservados.
          </p>
        </footer>
      </div>
    </div>
  );
}


// =====================================================
// PROCESSAMENTO
// =====================================================

function ProcessingScreen({ processIndex }) {
  const items = [
    "Validando respostas...",
    "Analisando perfil...",
    "Gerando resultado...",
  ];

  return (
    <section className="py-8 text-center">

      <div className="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-indigo-50">
        <div className="h-10 w-10 animate-spin rounded-full border-4 border-gray-200 border-t-indigo-600" />
      </div>

      <h2 className="text-2xl font-bold text-gray-900">
        Processando suas respostas...
      </h2>

      <p className="mt-2 text-sm text-gray-500">
        Estamos preparando seu resultado personalizado.
      </p>

      <div className="mt-8 space-y-3 text-left">

        {items.map((item, index) => {
          const completed = processIndex > index;

          return (
            <div
              key={item}
              className={`flex items-center gap-3 rounded-xl border p-4 transition-all duration-500 ${
                completed
                  ? "border-green-100 bg-green-50"
                  : "border-gray-100 bg-gray-50"
              }`}
            >
              <div
                className={`flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold ${
                  completed
                    ? "bg-green-500 text-white"
                    : "bg-white text-gray-400"
                }`}
              >
                {completed ? "✓" : index + 1}
              </div>

              <span
                className={`text-sm font-medium ${
                  completed
                    ? "text-green-700"
                    : "text-gray-500"
                }`}
              >
                {item}
              </span>

              {!completed && processIndex === index && (
                <div className="ml-auto h-4 w-4 animate-spin rounded-full border-2 border-gray-200 border-t-indigo-500" />
              )}
            </div>
          );
        })}
      </div>
    </section>
  );
}


// =====================================================
// PÁGINA DO VÍDEO
// =====================================================

function VideoPage({ name }) {
  return (
    <div className="min-h-screen bg-gray-100 px-4 py-6 sm:py-10">

      <div className="mx-auto w-full max-w-3xl overflow-hidden rounded-2xl bg-white shadow-xl">

        {/* HEADER */}

        <header className="border-b border-gray-100 px-5 py-5 sm:px-7">
          <div className="flex items-center justify-between">

            <div className="flex items-center gap-2">
              <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-xl text-white">
                ★
              </div>

              <div>
                <h1 className="text-lg font-bold text-gray-900">
                  QuizApp
                </h1>

                <p className="text-xs text-gray-500">
                  Seu resultado
                </p>
              </div>
            </div>

            <span className="rounded-full bg-green-50 px-3 py-1.5 text-xs font-bold text-green-600">
              ✓ Status: Concluído
            </span>

          </div>
        </header>

        {/* VIDEO */}

        <main className="px-5 py-7 sm:px-7 sm:py-9">

          <div className="mb-6">
            <h2 className="text-2xl font-bold text-gray-900">
              Olá, {name}!
            </h2>

            <p className="mt-2 text-sm text-gray-500">
              Assista à análise completa do seu perfil.
            </p>
          </div>

          <div className="relative aspect-video w-full overflow-hidden rounded-2xl bg-black shadow-lg">

            {/* =================================================
                COLOQUE SEU EMBED AQUI
                ================================================= */}

            <iframe
              className="absolute inset-0 h-full w-full"
              src="https://www.youtube.com/embed/SEU_VIDEO_AQUI"
              title="Vídeo do resultado"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowFullScreen
            />

          </div>

          <div className="mt-5 flex gap-3 rounded-xl border border-amber-100 bg-amber-50 p-4">

            <div className="text-xl">
              ⚠️
            </div>

            <p className="text-sm leading-6 text-amber-800">
              <strong>Importante:</strong> assista ao vídeo até
              o final para entender a análise completa do seu
              perfil.
            </p>

          </div>

        </main>

        <footer className="border-t border-gray-100 px-5 py-5 text-center">
          <p className="text-xs text-gray-400">
            © 2026 Todos os direitos reservados.
          </p>
        </footer>

      </div>
    </div>
  );
}
